# Copy to .env and set a unique password before Docker startup.
ORACLE_AUTH_USER=oracle
ORACLE_AUTH_PASSWORD=
ORACLE_PORT=8787
ORACLE_TORCH_THREADS=4
# Native local execution only (Docker uses /data):
ORACLE_DATA_DIR=data
# Optional JEV headline evaluation via Vercel AI Gateway (paid API).
# Enable after setting your own key. The cap counts attempts, including failed requests.
AI_GATEWAY_API_KEY=
ORACLE_JEV_ENABLED=0
ORACLE_JEV_DAILY_REQUESTS=200
# Prospective virtual portfolios; never places real exchange orders.
ORACLE_PAPER_ENABLED=0
# Additional prospectively funded comparison with a common initial allocation.
ORACLE_PAPER_V2_ENABLED=0
# Independently reviewed outcomes and a separate calibration shadow experiment.
ORACLE_LEARNING_ENABLED=0
# Server-to-public-site publication key, configured privately after deployment.
ORACLE_PUBLIC_TOKEN=

# Copy to .env and set a unique password before Docker startup.
ORACLE_AUTH_USER=oracle
ORACLE_AUTH_PASSWORD=
ORACLE_PORT=8787
ORACLE_TORCH_THREADS=4
# Native local execution only (Docker uses /data):
ORACLE_DATA_DIR=data
# Optional headline annotations with Laya, a local open-source model inside the worker.
# No API key. The first run downloads a pinned ~850 MB checkpoint; it needs ~2 GB more worker memory.
ORACLE_LAYA_ENABLED=0
# Prospective virtual portfolios; never places real exchange orders.
ORACLE_PAPER_ENABLED=0
# Additional prospectively funded comparison with a common initial allocation.
ORACLE_PAPER_V2_ENABLED=0
# Third paper run: a frozen trend rule against a rebalanced and a held benchmark. No forecasts, no news.
ORACLE_PAPER_V3_ENABLED=0
# Independently reviewed outcomes and a separate calibration shadow experiment.
ORACLE_LEARNING_ENABLED=0
# Prospective shadow experiment: pooled volatility band vs TimesFM's own raw band.
ORACLE_VOLBAND_ENABLED=0
# Weekly public digest pushed to the website, Mondays after 07:00 UTC. Subscriber addresses never reach this server.
ORACLE_NEWSLETTER_ENABLED=0
# Server-to-public-site publication key, configured privately after deployment.
ORACLE_PUBLIC_TOKEN=
